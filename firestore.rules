rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function getUserRole() {
      return isAuthenticated() ? 
        (request.auth.token.role != null ? request.auth.token.role : 
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? getUserData().role : 'customer')) 
        : 'public';
    }

    function isAdmin() {
      return isAuthenticated() && (getUserRole() == 'admin' || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin'));
    }
    
    function isFrontDesk() {
      return isAuthenticated() && (isAdmin() || getUserRole() == 'front_desk');
    }

    function isCallCenter() {
      return isAuthenticated() && (isAdmin() || getUserRole() == 'call_center');
    }

    function isStaff() {
      return isAuthenticated() && (isAdmin() || isFrontDesk() || getUserRole() == 'staff');
    }

    function isOperational() {
      return isAdmin() || isFrontDesk() || isCallCenter();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
    
    // USERS COLLECTION
    match /users/{userId} {
      allow read: if isOperational() || isUser(userId);
      allow create: if isAdmin() || (isAuthenticated() && request.auth.uid == userId && request.resource.data.role == 'customer');
      allow update: if isAdmin() || 
        (isUser(userId) && 
         request.resource.data.role == resource.data.role &&
         request.resource.data.active == resource.data.active);
      allow delete: if isAdmin();
    }
    
    // CUSTOMERS / PROSPECTS COLLECTION
    match /customers/{customerId} {
      allow read: if isOperational() || isStaff();
      allow create, update: if isOperational();
      allow delete: if isAdmin();
    }

    // CALL LOGS COLLECTION
    match /callLogs/{logId} {
      allow read: if isOperational();
      allow create: if isCallCenter() || isAdmin();
      allow update, delete: if isAdmin();
    }

    // FOLLOW-UPS & CALLBACKS COLLECTION
    match /followUps/{followUpId} {
      allow read: if isOperational();
      allow create, update: if isOperational();
      allow delete: if isAdmin();
    }
    
    // SERVICES COLLECTION
    match /services/{serviceId} {
      allow read: if resource.data.isActive == true || isOperational();
      allow write: if isAdmin();
    }

    // ROOMS COLLECTION
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // APPOINTMENTS COLLECTION
    match /appointments/{appointmentId} {
      allow read: if isOperational() || 
        (isStaff() && (resource.data.staffId == request.auth.uid || resource.data.assignedStaffId == request.auth.uid)) ||
        (isAuthenticated() && resource.data.customerId == request.auth.uid);
        
      // Created exclusively by Call Center, Front Desk, or Admin
      allow create: if isOperational();
        
      // Front Desk / Admin can update everything; Staff can only update clinical notes and status
      allow update: if isFrontDesk() ||
        (isStaff() && resource.data.assignedStaffId == request.auth.uid &&
         request.resource.data.fee == resource.data.fee &&
         request.resource.data.amountInr == resource.data.amountInr);
         
      allow delete: if isAdmin();
    }

    // CONSULTATIONS COLLECTION
    match /consultations/{consultationId} {
      allow read: if isOperational() || isStaff();
      allow create: if isFrontDesk() || isStaff();
      allow update, delete: if isFrontDesk();
    }

    // PACKAGES COLLECTION
    match /packages/{packageId} {
      allow read: if isOperational() || isStaff();
      allow create, update: if isFrontDesk();
      allow delete: if isAdmin();
    }

    // SESSIONS COLLECTION
    match /sessions/{sessionId} {
      allow read: if isOperational() || isStaff();
      allow create: if isFrontDesk();
      allow update: if isFrontDesk() || isStaff();
      allow delete: if isAdmin();
    }

    // INVOICES & BILLING
    match /invoices/{invoiceId} {
      allow read: if isFrontDesk() || isAdmin();
      allow create, update: if isFrontDesk();
      allow delete: if isAdmin();
    }

    // PAYMENTS TRANSACTIONS
    match /payments/{paymentId} {
      allow read: if isFrontDesk() || isAdmin();
      allow create: if isFrontDesk();
      allow update, delete: if isAdmin();
    }

    // PAYMENT FOLLOW-UPS (POSTPONEMENTS)
    match /paymentFollowUps/{pfId} {
      allow read, create, update: if isFrontDesk() || isAdmin();
      allow delete: if isAdmin();
    }

    // AUDIT LOGS
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit log
    }
    
    // REVIEWS COLLECTION
    match /reviews/{reviewId} {
      allow read: if resource.data.isApproved == true || isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
    
    // CONTACT INQUIRIES
    match /contactInquiries/{inquiryId} {
      allow read, update, delete: if isOperational();
      allow create: if true;
    }
    
    // BUSINESS SETTINGS
    match /businessSettings/{settingsId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
